[configuration]

entry_symbol = "noita_engine_library_init"
compatibility_minimum = "4.7"

[libraries]

linux.debug.x86_64 = "res://bin/libnoita_engine.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libnoita_engine.linux.template_release.x86_64.so"
macos.debug.arm64 = "res://bin/libnoita_engine.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://bin/libnoita_engine.macos.template_release.arm64.dylib"
