#!/usr/bin/env python
"""Build the noita_engine GDExtension and the host-side C++ test binary.

    scons platform=macos arch=arm64 target=template_debug   # extension -> bin/
    scons tests && build/tests/run_tests                     # core unit tests
"""

import os
import subprocess

env = Environment()
customs = ["custom.py"]

# ADDON is this directory; THIRDPARTY holds godot-cpp and box2d. build.sh passes
# thirdparty=<dir>; otherwise $NOITA_THIRDPARTY, the development repo's
# thirdparty/, or this addon's own thirdparty/ (a copied addon's default).
ADDON = Dir(".")
try:
    _repo = subprocess.check_output(
        ["git", "-C", str(ADDON), "rev-parse", "--show-toplevel"],
        text=True, stderr=subprocess.DEVNULL,
    ).strip()
except (OSError, subprocess.CalledProcessError):
    _repo = ""
THIRDPARTY = (
    ARGUMENTS.get("thirdparty")
    or os.environ.get("NOITA_THIRDPARTY")
    or os.path.join(_repo or ADDON.abspath, "thirdparty")
)
# Consume it so godot-cpp's SConstruct doesn't warn about an unknown variable.
ARGUMENTS.pop("thirdparty", None)
THIRDPARTY = str(THIRDPARTY)

env["ARCOM"] = "${TEMPFILE('$AR $ARFLAGS $TARGET $SOURCES')}"

SConscript(
    os.path.join(THIRDPARTY, "godot-cpp", "SConstruct"),
    {"env": env, "customs": customs, "api_version": "4.7"},
)

# Box2D v3.2.0 (git submodule) is compiled into the extension and the test binary as C17.
# No SIMD defines: it picks SSE2 / NEON itself.
box2d_sources = Glob(os.path.join(THIRDPARTY, "box2d", "src", "*.c"))

env.Append(CPPPATH=[str(ADDON.abspath) + "/engine", str(ADDON.abspath) + "/engine/core", str(ADDON.abspath) + "/rules", THIRDPARTY, os.path.join(THIRDPARTY, "box2d", "include")])
env.Append(CFLAGS=["-std=c17"])
# Objects go to build/obj/, not next to the sources, so the addon folder stays clean;
# sources are referenced through the variant dir for that to apply.
env.VariantDir("build/obj", ".", duplicate=0)
sources = Glob("build/obj/engine/core/*.cpp") + Glob("build/obj/engine/godot/*.cpp") + Glob("build/obj/rules/*.cpp") + box2d_sources

# libnoita_engine.<platform>.<target>.<arch>.<ext> — godot-cpp's suffix without
# the .dev/.universal markers, keeping the arch.
suffix = env["suffix"].replace(".dev", "").replace(".universal", "")
library = env.SharedLibrary(
    "bin/libnoita_engine" + suffix + env["SHLIBSUFFIX"], source=sources
)
Default(library)

# Core unit tests: host toolchain only, no godot-cpp flags (engine/core has no Godot dependency).
tests_env = Environment()
tests_env.Append(CPPPATH=[str(ADDON.abspath) + "/engine", str(ADDON.abspath) + "/engine/core", str(ADDON.abspath) + "/rules", THIRDPARTY, os.path.join(THIRDPARTY, "box2d", "include")])
tests_env.Append(CFLAGS=["-std=c17", "-O2", "-g", "-pthread"])
tests_env.Append(
    CXXFLAGS=["-O2", "-g", "-pthread", "-std=c++17"],
    LINKFLAGS=["-pthread"],
)
# scons tests tsan=yes — ThreadSanitizer for the test binary only; the extension build and
# its env are untouched, so a shipped library never carries the sanitizer runtime. -g above
# keeps the reports pointing at source lines.
if ARGUMENTS.get("tsan") == "yes":
    tests_env.Append(CXXFLAGS=["-fsanitize=thread"], LINKFLAGS=["-fsanitize=thread"])
tests_env.VariantDir("build/obj", ".", duplicate=0)
tests_dir = Dir(ARGUMENTS.get("tests_dir") or os.path.join(_repo, "tests", "core"))
tests = tests_env.Program(
    "build/tests/run_tests",
    source=Glob("build/obj/engine/core/*.cpp") + Glob("build/obj/rules/*.cpp") + Glob(os.path.join(str(tests_dir), "*.cpp")) + box2d_sources,
)
Alias("tests", tests)
